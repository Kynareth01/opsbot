# OpsBot Environment Variables
# Copy this to .env and fill in your values

# Alert channels
OPSBOT_SLACK_WEBHOOK=
OPSBOT_DISCORD_WEBHOOK=
OPSBOT_TELEGRAM_BOT_TOKEN=
OPSBOT_TELEGRAM_CHAT_ID=
OPSBOT_PAGERDUTY_TOKEN=
OPSBOT_PAGERDUTY_SERVICE_ID=

# Monitoring thresholds
OPSBOT_CPU_THRESHOLD=90
OPSBOT_MEMORY_THRESHOLD=85
OPSBOT_DISK_THRESHOLD=90

# Remediation
OPSBOT_REMEDIATION_DRY_RUN=false

# Logging
OPSBOT_LOG_LEVEL=INFO
